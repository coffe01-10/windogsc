<Window x:Class="DogSC.RecorderBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DogSC"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="DogSC"
        SizeToContent="WidthAndHeight" UseLayoutRounding="True" PreviewMouseWheel="Bar_PreviewMouseWheel"
        WindowStyle="None" Background="Transparent" Foreground="{DynamicResource InkBrush}"
        Topmost="True" ShowInTaskbar="True" ResizeMode="NoResize"
        FontFamily="{DynamicResource FontRegular}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="-1" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="RecorderActionButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Background" Value="{DynamicResource SegmentSelectedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassEdgeBrush}"/>
            <Setter Property="BorderThickness" Value="0.75"/>
        </Style>
        <DataTemplate x:Key="RecorderToolContent">
            <Grid Width="48">
                <Grid.RowDefinitions>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="18"/>
                </Grid.RowDefinitions>
                <local:Icon Kind="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="2" Text="{Binding}" FontSize="12" LineHeight="18" LineStackingStrategy="BlockLineHeight" TextAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
        <Style x:Key="RecorderToolButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ContentTemplate" Value="{StaticResource RecorderToolContent}"/>
        </Style>
    </Window.Resources>
    <Grid x:Name="BarRoot" Width="860" Height="124" HorizontalAlignment="Left" VerticalAlignment="Top" ClipToBounds="True">
        <Grid.LayoutTransform><ScaleTransform x:Name="BarScale" ScaleX="0.85" ScaleY="0.85"/></Grid.LayoutTransform>
        <Border x:Name="BarShell" Margin="16,12,16,8" Background="{DynamicResource RecorderSurfaceBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="0.75" CornerRadius="24" Padding="13,9">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.16" Direction="90"/>
            </Border.Effect>
            <Grid x:Name="ShellGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/><RowDefinition Height="0"/></Grid.RowDefinitions>
                <Border x:Name="DragHandle" Background="Transparent" Cursor="SizeAll" ToolTip="{local:Localize '拖动录制条，靠近屏幕边缘自动吸附'}" MouseLeftButtonDown="DragBar">
                    <local:Icon x:Name="GripIcon" Kind="Grip" Width="16" Height="26" Foreground="{DynamicResource InkSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <Grid x:Name="ContentHost" Grid.Column="1">
                <StackPanel x:Name="SetupPanel" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="DisplayButton" Content="{local:Localize '显示器'}" Tag="{x:Static local:IconKind.Monitor}" Style="{StaticResource RecorderToolButton}" Click="Display_Click" AutomationProperties.AutomationId="SourceDisplay"/>
                    <Button Content="{local:Localize '窗口'}" Tag="{x:Static local:IconKind.Window}" Style="{StaticResource RecorderToolButton}" Click="Window_Click" AutomationProperties.AutomationId="SourceWindow"/>
                    <Button Content="{local:Localize '区域'}" Tag="{x:Static local:IconKind.Region}" Style="{StaticResource RecorderToolButton}" Click="Region_Click" AutomationProperties.AutomationId="SourceRegion"/>
                    <Button Content="{local:Localize '设备'}" Tag="{x:Static local:IconKind.Device}" Style="{StaticResource RecorderToolButton}" Click="Device_Click" AutomationProperties.AutomationId="SourceDevice"/>
                    <Rectangle Width="1" Height="36" Fill="{DynamicResource LineBrush}" Margin="8,0"/>
                    <Button x:Name="MicButton" ToolTip="{local:Localize '麦克风'}" AutomationProperties.Name="{local:Localize '麦克风'}" Style="{StaticResource RecorderToolButton}" ContentTemplate="{x:Null}" Click="Mic_Click" AutomationProperties.AutomationId="MicToggle">
                        <Grid Width="48">
                            <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="6"/><RowDefinition Height="18"/></Grid.RowDefinitions>
                            <Grid Width="26" Height="24" HorizontalAlignment="Center">
                                <local:Icon Kind="Mic" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Ellipse x:Name="MicDot" Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" Stroke="{DynamicResource RecorderSurfaceBrush}" StrokeThickness="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Visibility="Collapsed"/>
                            </Grid>
                            <TextBlock Grid.Row="2" Text="{local:Localize '麦克风'}" FontSize="12" LineHeight="18" LineStackingStrategy="BlockLineHeight" TextAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button x:Name="CameraButton" ToolTip="{local:Localize '摄像头画中画'}" AutomationProperties.Name="{local:Localize '摄像头画中画'}" Style="{StaticResource RecorderToolButton}" ContentTemplate="{x:Null}" Click="Camera_Click" AutomationProperties.AutomationId="CameraToggle">
                        <Grid Width="48">
                            <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="6"/><RowDefinition Height="18"/></Grid.RowDefinitions>
                            <Grid Width="26" Height="24" HorizontalAlignment="Center">
                                <local:Icon Kind="Camera" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Ellipse x:Name="CameraDot" Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" Stroke="{DynamicResource RecorderSurfaceBrush}" StrokeThickness="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Visibility="Collapsed"/>
                            </Grid>
                            <TextBlock Grid.Row="2" Text="{local:Localize '摄像头'}" FontSize="12" LineHeight="18" LineStackingStrategy="BlockLineHeight" TextAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button x:Name="AudioButton" ToolTip="{local:Localize '系统声音'}" AutomationProperties.Name="{local:Localize '系统声音'}" Style="{StaticResource RecorderToolButton}" ContentTemplate="{x:Null}" Click="SystemAudio_Click" AutomationProperties.AutomationId="SystemAudioToggle">
                        <Grid Width="48">
                            <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="6"/><RowDefinition Height="18"/></Grid.RowDefinitions>
                            <Grid Width="26" Height="24" HorizontalAlignment="Center">
                                <local:Icon Kind="Speaker" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Ellipse x:Name="AudioDot" Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" Stroke="{DynamicResource RecorderSurfaceBrush}" StrokeThickness="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Visibility="Collapsed"/>
                            </Grid>
                            <TextBlock Grid.Row="2" Text="{local:Localize '系统声'}" FontSize="12" LineHeight="18" LineStackingStrategy="BlockLineHeight" TextAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Rectangle Width="1" Height="36" Fill="{DynamicResource LineBrush}" Margin="8,0"/>
                    <Button x:Name="FolderButton" Style="{StaticResource RecorderToolButton}" Width="112" ContentTemplate="{x:Null}" ToolTip="{local:Localize '选择保存位置'}" AutomationProperties.Name="{local:Localize '保存位置'}" Click="Folder_Click" AutomationProperties.AutomationId="SaveTarget">
                        <Grid x:Name="FolderContent" Width="96">
                            <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="6"/><RowDefinition Height="18"/></Grid.RowDefinitions>
                            <local:Icon Kind="Folder" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" x:Name="FolderLabel" Text="{local:Localize '项目'}" TextTrimming="CharacterEllipsis" FontSize="12" LineHeight="18" LineStackingStrategy="BlockLineHeight" TextAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button x:Name="MainMenuButton" Content="{local:Localize '菜单'}" Tag="{x:Static local:IconKind.Menu}" ToolTip="{local:Localize '项目、备忘录与设置'}" AutomationProperties.Name="{local:Localize '主菜单'}" Style="{StaticResource RecorderToolButton}" Width="48" Click="Menu_Click" AutomationProperties.AutomationId="MainMenu" Margin="6,0,2,0"/>
                    <Button x:Name="MainCloseButton" Content="{local:Localize '关闭'}" Tag="{x:Static local:IconKind.Close}" ToolTip="{local:Localize '关闭录制条'}" AutomationProperties.Name="{local:Localize '关闭录制条'}" Style="{StaticResource RecorderToolButton}" Width="48" Click="Close_Click" AutomationProperties.AutomationId="CloseButton"/>
                </StackPanel>
                <DockPanel x:Name="RecordingPanel" Background="Transparent" Visibility="Collapsed" LastChildFill="False">
                    <StackPanel x:Name="RecordingHeader" Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                        <Ellipse Width="10" Height="10" Fill="{DynamicResource RecordBrush}" Margin="8,0,8,0"/>
                        <TextBlock x:Name="TimerLabel" Text="00:00" FontFamily="{DynamicResource FontSemi}" FontWeight="SemiBold" FontSize="20" VerticalAlignment="Center"/>
                        <TextBlock x:Name="RecordingLabel" MaxWidth="140" TextTrimming="CharacterEllipsis" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource InkSecondaryBrush}"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Height="36" Padding="14,8" VerticalAlignment="Center" Style="{StaticResource RecorderActionButton}" Click="Stop_Click" Margin="8,0,4,0" AutomationProperties.AutomationId="StopButton">
                        <StackPanel Orientation="Horizontal">
                            <local:Icon Kind="Stop" Foreground="{DynamicResource RecordBrush}" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{local:Localize '停止'}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button DockPanel.Dock="Right" Height="36" VerticalAlignment="Center" Style="{StaticResource QuietButton}" Click="Pause_Click" x:Name="PauseButton">
                        <StackPanel Orientation="Horizontal">
                            <local:Icon x:Name="PauseIcon" Kind="Pause" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="PauseLabel" Text="{local:Localize '暂停'}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button DockPanel.Dock="Right" Height="36" VerticalAlignment="Center" Style="{StaticResource QuietButton}" Click="Marker_Click">
                        <StackPanel Orientation="Horizontal">
                            <local:Icon Kind="Flag" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{local:Localize '标记'}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="MarkerCount" Text="0" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button DockPanel.Dock="Right" Height="36" VerticalAlignment="Center" Style="{StaticResource IconButton}" Click="Memo_Click" ToolTip="{local:Localize '备忘录'}" AutomationProperties.Name="{local:Localize '备忘录'}"><local:Icon Kind="Window"/></Button>
                    <Button x:Name="RecordingMicButton" DockPanel.Dock="Right" Height="36" VerticalAlignment="Center" Style="{StaticResource IconButton}" Click="RecordingMic_Click" ToolTip="{local:Localize '静音麦克风'}" AutomationProperties.Name="{local:Localize '静音麦克风'}"><local:Icon Kind="Mic"/></Button>
                </DockPanel>
                <StackPanel x:Name="CompactPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <Button x:Name="CompactRecord" Height="36" Padding="14,8" Style="{StaticResource RecorderActionButton}" ToolTip="{local:Localize '选择显示器并开始录制'}" AutomationProperties.Name="{local:Localize '开始录制'}" Click="Display_Click">
                        <StackPanel x:Name="CompactRecordContent" Orientation="Horizontal">
                            <local:Icon x:Name="CompactRecordIcon" Kind="Record" Foreground="{DynamicResource RecordBrush}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{local:Localize '录制'}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <StackPanel x:Name="CompactRecording" Orientation="Horizontal" Visibility="Collapsed">
                        <Button Style="{StaticResource IconButton}" Width="32" Height="36" Padding="7" ToolTip="{local:Localize '备忘录'}" AutomationProperties.Name="{local:Localize '备忘录'}" Click="Memo_Click"><local:Icon Kind="Window" Width="18" Height="18"/></Button>
                        <Button x:Name="CompactRecordingMic" Style="{StaticResource IconButton}" Width="32" Height="36" Padding="7" ToolTip="{local:Localize '静音麦克风'}" AutomationProperties.Name="{local:Localize '静音麦克风'}" Click="RecordingMic_Click"><local:Icon Kind="Mic" Width="18" Height="18"/></Button>
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource RecordBrush}" Margin="2,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CompactTimer" Text="00:00" MinWidth="56" FontSize="16" VerticalAlignment="Center" FontFamily="{DynamicResource FontMedium}" FontWeight="Medium"/>
                        <Button x:Name="CompactPause" Style="{StaticResource IconButton}" Width="32" Height="36" Padding="7" ToolTip="{local:Localize '暂停录制'}" AutomationProperties.Name="{local:Localize '暂停录制'}" Click="Pause_Click"><local:Icon x:Name="CompactPauseIcon" Kind="Pause" Width="18" Height="18"/></Button>
                        <Button Style="{StaticResource IconButton}" Width="32" Height="36" Padding="7" ToolTip="{local:Localize '停止录制'}" AutomationProperties.Name="{local:Localize '停止录制'}" Click="Stop_Click"><local:Icon Kind="Stop" Foreground="{DynamicResource RecordBrush}" Width="18" Height="18"/></Button>
                    </StackPanel>
                    <Button x:Name="CompactMenu" Style="{StaticResource IconButton}" Width="32" Height="36" Padding="7" Margin="4,0,0,0" ToolTip="{local:Localize '主菜单'}" AutomationProperties.Name="{local:Localize '主菜单'}" Click="Menu_Click"><local:Icon Kind="Menu" Width="18" Height="18"/></Button>
                    <Button Style="{StaticResource IconButton}" Width="32" Height="36" Padding="7" ToolTip="{local:Localize '关闭录制条'}" AutomationProperties.Name="{local:Localize '关闭录制条'}" Click="Close_Click"><local:Icon Kind="Close" Width="18" Height="18"/></Button>
                </StackPanel>
                </Grid>
                <Button x:Name="CollapseButton" Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="{local:Localize '收起工具条'}" AutomationProperties.Name="{local:Localize '收起工具条'}" Click="Collapse_Click"><local:Icon x:Name="CollapseIcon" Kind="ChevronLeft" Width="20" Height="20"/></Button>
            </Grid>
        </Border>
        <TextBlock x:Name="ErrorText" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16,0,16,0"
                   Foreground="{DynamicResource RecordBrush}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" TextAlignment="Center"/>
        <Popup x:Name="SizePopup" Placement="Bottom" PlacementTarget="{Binding ElementName=CollapseButton}" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{DynamicResource CardBrush}" CornerRadius="14" Padding="16" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                <StackPanel Width="220">
                    <TextBlock Text="{local:Localize '工具条大小'}" FontFamily="{DynamicResource FontMedium}" FontWeight="Medium"/>
                    <Grid Margin="0,12,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                        <Slider x:Name="BarSizeSlider" Minimum="0.7" Maximum="1.1" Value="0.85" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="BarSize_Changed" ToolTip="{local:Localize '调整整个工具条的大小'}" AutomationProperties.Name="{local:Localize '工具条大小'}"/>
                        <TextBlock x:Name="BarSizeLabel" Grid.Column="1" Text="85%" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{local:Localize '也可按住 Ctrl 滚动鼠标滚轮'}" FontSize="11" Foreground="{DynamicResource InkSecondaryBrush}"/>
                    <Button Content="{local:Localize '恢复默认大小'}" Style="{StaticResource QuietButton}" Margin="0,8,0,0" Click="ResetBarSize_Click"/>
                </StackPanel>
            </Border>
        </Popup>
        <Popup x:Name="ListPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="6" MinWidth="280" MaxHeight="360">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.18" Direction="90"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ListItems"/>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</Window>
