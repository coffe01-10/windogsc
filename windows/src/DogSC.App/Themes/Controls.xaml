<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="FontRegular">pack://application:,,,/Fonts/AlibabaPuHuiTi-3-55-Regular.otf#阿里巴巴普惠体 3.0 55 Regular</FontFamily>
    <FontFamily x:Key="FontMedium">pack://application:,,,/Fonts/AlibabaPuHuiTi-3-65-Medium.otf#阿里巴巴普惠体 3.0 65 Medium</FontFamily>
    <FontFamily x:Key="FontSemi">pack://application:,,,/Fonts/AlibabaPuHuiTi-3-75-SemiBold.otf#阿里巴巴普惠体 3.0 75 SemiBold</FontFamily>

    <Style x:Key="QuietButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontMedium}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource WellBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
        <Setter Property="Padding" Value="18,10"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.88"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
        <Setter Property="Background" Value="{DynamicResource WellBrush}"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Margin" Value="4,0"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontRegular}"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource FontRegular}"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource InkBrush}"/>
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="Padding" Value="10,8"/>
    </Style>
</ResourceDictionary>
