<Window x:Class="DogSC.RegionOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="#66000000"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" Cursor="Cross">
    <Canvas x:Name="Surface">
        <Border x:Name="Selection" BorderBrush="White" BorderThickness="2" CornerRadius="4" Visibility="Collapsed">
            <Border.Background>
                <SolidColorBrush Color="White" Opacity="0.08"/>
            </Border.Background>
            <TextBlock x:Name="SizeLabel" Margin="8" Foreground="White" FontSize="13" VerticalAlignment="Bottom"/>
        </Border>
        <TextBlock x:Name="Hint" Text="拖出要录制的区域，松开后开始。Esc 取消。" Foreground="White" FontSize="16"/>
    </Canvas>
</Window>
