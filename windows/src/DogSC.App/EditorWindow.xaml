<Window x:Class="DogSC.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DogSC"
        Title="DogSC" Width="1440" Height="920" MinWidth="960" MinHeight="600" UseLayoutRounding="True"
        Background="{DynamicResource BgBrush}" FontFamily="{DynamicResource FontRegular}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*" MinHeight="140"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="304" MinHeight="294"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="16,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/Assets/AppIconMaster.png" Width="22" Height="22" Margin="0,0,8,0"/>
                <TextBox x:Name="NameBox" MinWidth="180" BorderThickness="0" Background="Transparent" FontFamily="{DynamicResource FontMedium}" FontSize="15" LostFocus="Name_LostFocus"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="UndoButton" ToolTip="撤销（Ctrl+Z）" AutomationProperties.Name="撤销" Style="{StaticResource IconButton}" Click="Undo_Click"><local:Icon Kind="Undo"/></Button>
                <Button x:Name="RedoButton" ToolTip="重做（Ctrl+Y）" AutomationProperties.Name="重做" Style="{StaticResource IconButton}" Click="Redo_Click"><local:Icon Kind="Redo"/></Button>
                <Button Content="导出" Style="{StaticResource PrimaryButton}" Click="Export_Click" Margin="8,0"/>
                <Button x:Name="ThemeButton" ToolTip="切换主题" AutomationProperties.Name="切换主题" Style="{StaticResource IconButton}" Click="Theme_Click"><local:Icon x:Name="ThemeIcon" Kind="Moon"/></Button>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88"/>
                <ColumnDefinition Width="*" MinWidth="260"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="320" MinWidth="260" MaxWidth="480"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="12,12,12,0">
                <Button x:Name="ToolLayout" Content="画面" Width="64" Height="64" Padding="0" Style="{StaticResource QuietButton}" Click="Tool_Click" Tag="layout" Margin="0,0,0,8"/>
                <Button x:Name="ToolZoom" Content="缩放" Width="64" Height="64" Padding="0" Style="{StaticResource QuietButton}" Click="Tool_Click" Tag="zoom" Margin="0,0,0,8"/>
                <Button x:Name="ToolEffects" Content="效果" Width="64" Height="64" Padding="0" Style="{StaticResource QuietButton}" Click="Tool_Click" Tag="effects" Margin="0,0,0,8"/>
                <Button x:Name="ToolAudio" Content="声音" Width="64" Height="64" Padding="0" Style="{StaticResource QuietButton}" Click="Tool_Click" Tag="audio" Margin="0,0,0,8"/>
            </StackPanel>
            <Grid Grid.Column="1" Margin="8,0,8,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <WrapPanel x:Name="AspectRow" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,8"/>
                <Grid x:Name="PreviewSlot" Grid.Row="1" SizeChanged="Preview_SizeChanged">
                    <Canvas ClipToBounds="True" x:Name="PreviewCanvas" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid x:Name="CanvasEffects">
                        <Canvas x:Name="SceneCanvas">
                        <Rectangle x:Name="StageRect" IsHitTestVisible="False"/>
                        <Image x:Name="WallpaperImage" Stretch="UniformToFill" Visibility="Collapsed" IsHitTestVisible="False">
                            <Image.Effect>
                                <BlurEffect x:Name="WallpaperBlur" Radius="0"/>
                            </Image.Effect>
                        </Image>
                        <Rectangle x:Name="ShadowRect" Fill="#55000000" IsHitTestVisible="False">
                            <Rectangle.Effect>
                                <BlurEffect Radius="12"/>
                            </Rectangle.Effect>
                        </Rectangle>
                        <Canvas x:Name="FrameHost" Background="Transparent" ClipToBounds="True" Cursor="SizeAll" MouseLeftButtonDown="Frame_Down" MouseMove="Frame_Move" MouseLeftButtonUp="Frame_Up">
                          <Grid x:Name="ScreenTexture">
                            <Grid x:Name="SourceEffects"><Rectangle x:Name="FrameRect"/></Grid>
                            <Canvas x:Name="CursorLayer" IsHitTestVisible="False" ClipToBounds="True">
                                <Ellipse x:Name="ClickRing" Visibility="Collapsed" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Fill="Transparent"/>
                                <Path x:Name="CursorShape" Data="M0,0 L0,17 L4.5,13 L7,19 L9.4,18 L7,12.4 L12,12 Z" Fill="White" Stroke="Black" StrokeThickness="1" Visibility="Collapsed"/>
                                <Ellipse x:Name="CursorDot" Width="10" Height="10" Fill="{DynamicResource AccentBrush}" Stroke="White" StrokeThickness="1.5" Visibility="Collapsed"/>
                                <Image x:Name="CursorBitmap" Visibility="Collapsed"/>
                                <Image x:Name="ClickBitmap" Visibility="Collapsed"/>
                            </Canvas>
                          </Grid>
                          <Viewport3D x:Name="ScreenPerspective" Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Canvas>
                        <Rectangle x:Name="CameraBubble" Visibility="Collapsed" IsHitTestVisible="False" StrokeThickness="2"/>
                        </Canvas>
                        </Grid>
                        <Canvas x:Name="StickerLayers" IsHitTestVisible="False"/>
                        <local:RegionEditSurface x:Name="RegionEditor" Visibility="Collapsed"/>
                        <local:RegionEditSurface x:Name="OverlayEditor" Visibility="Collapsed"/>
                    </Canvas>
                </Grid>
            </Grid>
            <GridSplitter Grid.Column="2" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="{DynamicResource LineBrush}" ToolTip="拖动调整属性面板宽度" AutomationProperties.Name="属性面板宽度"/>
            <Border Grid.Column="3" Margin="8,12,16,12" Background="{DynamicResource CardBrush}" CornerRadius="16" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Inspector"/>
                </ScrollViewer>
            </Border>
        </Grid>
        <GridSplitter Grid.Row="2" Height="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="Transparent" Cursor="SizeNS" ToolTip="拖动调整时间线高度" AutomationProperties.Name="时间线高度">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="{TemplateBinding Background}">
                        <Border Height="2" Background="{DynamicResource LineBrush}" VerticalAlignment="Center"/>
                        <Border Width="48" Height="4" CornerRadius="2" Background="{DynamicResource InkSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>
        <Border Grid.Row="3" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="12,8,12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="78"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="分割" ToolTip="在播放头分割（S）" Style="{StaticResource QuietButton}" Click="Split_Click"/>
                        <Button Content="删除" ToolTip="删除所选片段（Delete）" Style="{StaticResource QuietButton}" Click="Delete_Click"/>
                        <Button x:Name="RestoreButton" Content="还原" ToolTip="还原所选片段附近被剪掉的源素材" Style="{StaticResource QuietButton}" Click="Restore_Click"/>
                        <Button Content="标记" ToolTip="在播放头添加标记（M）" Style="{StaticResource QuietButton}" Click="Marker_Click"/>
                        <ComboBox x:Name="SpeedBox" Width="88" Margin="8,0,0,0" VerticalAlignment="Center" SelectionChanged="Speed_Changed"/>
                        <Rectangle Width="1" Height="20" Fill="{DynamicResource LineBrush}" Margin="8,0" VerticalAlignment="Center"/>
                        <Button Content="复制效果" ToolTip="复制所选缩放或素材效果（Ctrl+C）" Style="{StaticResource QuietButton}" Click="CopyEffect_Click"/>
                        <Button Content="粘贴效果" ToolTip="粘贴缩放副本，或向所选素材粘贴效果（Ctrl+V）" Style="{StaticResource QuietButton}" Click="PasteEffect_Click"/>
                        <Button Content="只粘属性" ToolTip="保留所选片段的位置和时长（Ctrl+Shift+V）" Style="{StaticResource QuietButton}" Click="PasteAttributes_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button ToolTip="回到开头" AutomationProperties.Name="回到开头" Style="{StaticResource IconButton}" Click="SkipStart_Click"><local:Icon Kind="SkipStart"/></Button>
                        <Button x:Name="PlayButton" ToolTip="播放（Space）" AutomationProperties.Name="播放" Style="{StaticResource IconButton}" Click="Play_Click"><local:Icon x:Name="PlayIcon" Kind="Play"/></Button>
                        <Button ToolTip="跳到结尾" AutomationProperties.Name="跳到结尾" Style="{StaticResource IconButton}" Click="SkipEnd_Click"><local:Icon Kind="SkipEnd"/></Button>
                        <TextBlock x:Name="TimeLabel" VerticalAlignment="Center" Margin="8,0,0,0" MaxWidth="650" TextTrimming="CharacterEllipsis" FontFamily="{DynamicResource FontMedium}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <CheckBox x:Name="SnapToggle" Content="吸附" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0" Checked="SnapToggle_Changed" Unchecked="SnapToggle_Changed" ToolTip="拖动时按刻度与片段边缘吸附"/>
                        <ComboBox x:Name="PreviewQualityBox" Width="86" VerticalAlignment="Center" Margin="0,0,10,0" SelectionChanged="PreviewQuality_Changed" ToolTip="预览画质">
                            <ComboBoxItem Content="清晰预览" Tag="low"/>
                            <ComboBoxItem Content="完整分辨率" Tag="full"/>
                        </ComboBox>
                        <TextBlock Text="时间线" VerticalAlignment="Center" Foreground="{DynamicResource InkSecondaryBrush}" Margin="0,0,8,0"/>
                        <Slider x:Name="TimelineZoom" Width="110" Minimum="1" Maximum="6" Value="1" ValueChanged="TimelineZoom_Changed"/>
                        <Button x:Name="TrackMenuButton" Content="轨道" Margin="8,0,0,0" VerticalAlignment="Center" Click="TrackMenu_Click">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="TrackMenu" Opened="TrackMenu_Opened">
                                    <MenuItem x:Name="TrackZoomItem" Header="缩放" IsCheckable="True" Click="TrackItem_Click"/>
                                    <MenuItem x:Name="TrackScreenMotionItem" Header="屏幕运动" IsCheckable="True" Click="TrackItem_Click"/>
                                    <MenuItem x:Name="TrackCameraMotionItem" Header="摄像头运动" IsCheckable="True" Click="TrackItem_Click"/>
                                    <Separator/>
                                    <MenuItem x:Name="TrackOverlayItem" Header="叠加（贴图/柔化）" IsCheckable="True" Click="TrackItem_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><local:TimelineControl x:Name="Timeline" Grid.Row="1"/></ScrollViewer>
            </Grid>
        </Border>
        <Grid x:Name="TourOverlay" Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="99" Visibility="Collapsed" Background="#66000000">
            <Border Width="380" Padding="24" CornerRadius="14" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="TourTitle" FontFamily="{DynamicResource FontSemi}" FontSize="20"/>
                    <TextBlock x:Name="TourBody" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource InkSecondaryBrush}"/>
                    <TextBlock x:Name="TourStep" Margin="0,14,0,0" Foreground="{DynamicResource InkSecondaryBrush}"/>
                    <DockPanel Margin="0,12,0,0">
                        <Button Content="跳过" Style="{StaticResource QuietButton}" Click="TourSkip_Click"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="TourPrev" Content="上一步" Style="{StaticResource QuietButton}" Margin="0,0,8,0" Click="TourPrev_Click"/>
                            <Button x:Name="TourNext" Content="下一步" Style="{StaticResource PrimaryButton}" Click="TourNext_Click"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
