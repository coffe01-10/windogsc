<Window x:Class="DogSC.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DogSC"
        Title="DogSC" Width="1440" Height="920" MinWidth="960" MinHeight="600" UseLayoutRounding="True"
        Background="{DynamicResource BgBrush}" FontFamily="{DynamicResource FontRegular}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid x:Name="WorkspaceRoot" SizeChanged="Workspace_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="HeaderRow" Height="56"/>
            <RowDefinition Height="*" MinHeight="140"/>
            <RowDefinition Height="8"/>
            <RowDefinition x:Name="TimelineRow" Height="228" MinHeight="170"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="16,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource QuietButton}" Padding="8" Width="38" Height="36" Click="ProjectFolder_Click" ToolTip="{local:Localize '打开项目文件夹'}"><local:Icon Kind="Folder" Width="20" Height="20"/></Button>
                <Button Style="{StaticResource QuietButton}" Padding="0" Width="12" Height="36" Margin="0,0,10,0" Click="ProjectFolder_Click" ToolTip="{local:Localize '项目文件夹'}"><local:Icon Kind="ChevronDown" Width="9" Height="9"/></Button>
                <TextBox x:Name="NameBox" MinWidth="180" BorderThickness="0" Background="Transparent" FontFamily="{DynamicResource FontMedium}" FontWeight="Medium" FontSize="14" LostFocus="Name_LostFocus"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="UndoButton" ToolTip="{local:Localize '撤销（Ctrl+Z）'}" AutomationProperties.Name="{local:Localize '撤销'}" Style="{StaticResource IconButton}" Click="Undo_Click"><local:Icon Kind="Undo"/></Button>
                <Button x:Name="RedoButton" ToolTip="{local:Localize '重做（Ctrl+Y）'}" AutomationProperties.Name="{local:Localize '重做'}" Style="{StaticResource IconButton}" Click="Redo_Click"><local:Icon Kind="Redo"/></Button>
                <Border Margin="8,0,0,0" CornerRadius="13" Padding="4" Background="{DynamicResource SegmentSelectedBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0.75">
                    <Button x:Name="SceneMenuButton" Style="{StaticResource QuietButton}" Click="SceneMenu_Click" Height="32" Padding="12,0">
                        <StackPanel Orientation="Horizontal"><local:Icon Kind="SceneStack" Width="14" Height="14" Margin="0,0,6,0"/><TextBlock x:Name="SceneMenuLabel" Text="{local:Localize '保存场景'}" VerticalAlignment="Center" FontFamily="{DynamicResource FontMedium}" FontWeight="Medium"/><Ellipse x:Name="SceneModified" Width="5" Height="5" Fill="#EDA629" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/><local:Icon x:Name="SceneMenuArrow" Kind="ChevronDown" Width="9" Height="9" Margin="6,0,0,0" Visibility="Collapsed"/></StackPanel>
                    </Button>
                </Border>
                <Button Style="{StaticResource QuietButton}" Click="Export_Click" Margin="8,0" BorderThickness="0.75" BorderBrush="{DynamicResource LineBrush}"><StackPanel Orientation="Horizontal"><local:Icon Kind="Share" Width="16" Height="16" Margin="0,0,6,0"/><TextBlock Text="{local:Localize '导出'}" VerticalAlignment="Center"/></StackPanel></Button>
                <Button ToolTip="{local:Localize '设置'}" AutomationProperties.Name="{local:Localize '设置'}" Style="{StaticResource IconButton}" Click="Settings_Click"><local:Icon Kind="Settings" Width="19" Height="19"/></Button>
                <Button x:Name="ThemeButton" ToolTip="{local:Localize '切换主题'}" AutomationProperties.Name="{local:Localize '切换主题'}" Style="{StaticResource IconButton}" Click="Theme_Click"><local:Icon x:Name="ThemeIcon" Kind="Moon"/></Button>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Background="{DynamicResource WorkspaceBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92"/>
                <ColumnDefinition Width="*" MinWidth="260"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition x:Name="InspectorColumn" Width="330" MinWidth="292" MaxWidth="480"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="ToolRailHost" Grid.Column="0" SizeChanged="ToolRail_SizeChanged">
                <Border x:Name="ToolRailSurface" Width="72" Padding="8" Margin="18,12,2,12" VerticalAlignment="Center" CornerRadius="20"
                        MaxHeight="{Binding ActualHeight, ElementName=ToolRailHost}"
                        Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0.75">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                      <Grid x:Name="ToolRailGrid">
                        <Border x:Name="ToolRailSelection" CornerRadius="12" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource RailSelectionBrush}" IsHitTestVisible="False">
                            <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                        </Border>
                        <StackPanel>
                            <Button x:Name="ToolLayout" Content="{local:Localize '画面'}" Width="56" Height="52" Padding="0" Style="{StaticResource QuietButton}" Click="Tool_Click" Tag="layout" Margin="0,0,0,5"/>
                            <Button x:Name="ToolOpening" Content="{local:Localize '开场'}" Width="56" Height="52" Padding="0" Style="{StaticResource QuietButton}" Click="Tool_Click" Tag="opening" Margin="0,0,0,5"/>
                            <Button x:Name="ToolZoom" Content="{local:Localize '运镜'}" Width="56" Height="52" Padding="0" Style="{StaticResource QuietButton}" Click="Tool_Click" Tag="zoom" Margin="0,0,0,5"/>
                            <Button x:Name="ToolCursor" Content="{local:Localize '光标'}" Width="56" Height="52" Padding="0" Style="{StaticResource QuietButton}" Click="Tool_Click" Tag="cursor" Margin="0,0,0,5"/>
                            <Button x:Name="ToolCamera" Content="{local:Localize '摄像头'}" Width="56" Height="52" Padding="0" Style="{StaticResource QuietButton}" Click="Tool_Click" Tag="camera" Margin="0,0,0,5"/>
                            <Button x:Name="ToolAudio" Content="{local:Localize '声音'}" Width="56" Height="52" Padding="0" Style="{StaticResource QuietButton}" Click="Tool_Click" Tag="audio"/>
                        </StackPanel>
                      </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>
            <Grid Grid.Column="1" Margin="8,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border x:Name="MonitorToolbarSurface" Grid.Row="0" HorizontalAlignment="Center" Margin="0,8,0,8" CornerRadius="12" Padding="4"
                        Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0.75">
                    <WrapPanel x:Name="AspectRow" Orientation="Horizontal"/>
                </Border>
                <Grid x:Name="PreviewSlot" Grid.Row="1" SizeChanged="Preview_SizeChanged">
                    <Grid x:Name="CropWorkspace" Visibility="Collapsed">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Rectangle x:Name="CropSource"/>
                            <local:RegionEditSurface x:Name="CropEditor"/>
                        </Grid>
                    </Grid>
                    <Canvas ClipToBounds="True" x:Name="PreviewCanvas" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid x:Name="CanvasEffects">
                        <Canvas x:Name="SceneCanvas">
                        <Rectangle x:Name="StageRect" IsHitTestVisible="False"/>
                        <Canvas x:Name="ProceduralBackground" IsHitTestVisible="False" ClipToBounds="True"/>
                        <Image x:Name="WallpaperImage" Stretch="UniformToFill" Visibility="Collapsed" IsHitTestVisible="False">
                            <Image.Effect>
                                <BlurEffect x:Name="WallpaperBlur" Radius="0"/>
                            </Image.Effect>
                        </Image>
                        <Rectangle x:Name="ShadowRect" Fill="#55000000" IsHitTestVisible="False">
                            <Rectangle.Effect>
                                <BlurEffect Radius="12"/>
                            </Rectangle.Effect>
                        </Rectangle>
                        <Canvas x:Name="FrameHost" Background="Transparent" ClipToBounds="True" Cursor="SizeAll" MouseLeftButtonDown="Frame_Down" MouseMove="Frame_Move" MouseLeftButtonUp="Frame_Up">
                          <Grid x:Name="ScreenTexture">
                            <Grid x:Name="SourceViewport" ClipToBounds="True"><Grid x:Name="SourceEffects"><Rectangle x:Name="FrameRect"/></Grid></Grid>
                            <Rectangle x:Name="LinearFocusOverlay" IsHitTestVisible="False" Visibility="Collapsed">
                                <Rectangle.Effect><BlurEffect x:Name="LinearFocusBlur"/></Rectangle.Effect>
                            </Rectangle>
                            <Canvas x:Name="CursorLayer" IsHitTestVisible="False" ClipToBounds="True">
                                <Ellipse x:Name="ClickRing" Visibility="Collapsed" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Fill="Transparent"/>
                                <Path x:Name="CursorShape" Data="M0,0 L0,17 L4.5,13 L7,19 L9.4,18 L7,12.4 L12,12 Z" Fill="White" Stroke="Black" StrokeThickness="1" Visibility="Collapsed"/>
                                <Ellipse x:Name="CursorDot" Width="10" Height="10" Fill="{DynamicResource AccentBrush}" Stroke="White" StrokeThickness="1.5" Visibility="Collapsed"/>
                                <Image x:Name="CursorBitmap" Visibility="Collapsed"/>
                                <Image x:Name="ClickBitmap" Visibility="Collapsed"/>
                            </Canvas>
                            <Rectangle x:Name="ScreenBorder" Stroke="White" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Grid>
                          <Image x:Name="FrameChrome" IsHitTestVisible="False"/>
                          <Viewport3D x:Name="ScreenPerspective" Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Canvas>
                        <Rectangle x:Name="CameraBubble" Visibility="Collapsed" IsHitTestVisible="False" StrokeThickness="2"/>
                        </Canvas>
                        </Grid>
                        <Canvas x:Name="StickerLayers" IsHitTestVisible="False"/>
                        <local:RegionEditSurface x:Name="RegionEditor" Visibility="Collapsed"/>
                        <local:RegionEditSurface x:Name="OverlayEditor" Visibility="Collapsed"/>
                        <Border x:Name="RegionToolbar" Visibility="Collapsed" Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="5"/>
                    </Canvas>
                    <Grid x:Name="PreviewTransitionLayer" IsHitTestVisible="False" ClipToBounds="True"/>
                </Grid>
            </Grid>
            <GridSplitter Grid.Column="2" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent" ToolTip="{local:Localize '拖动调整属性面板宽度'}" AutomationProperties.Name="{local:Localize '属性面板宽度'}"/>
            <Grid Grid.Column="3" Margin="8,0,16,0">
                <Grid.RowDefinitions><RowDefinition x:Name="InspectorToolbarRow" Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border x:Name="InspectorSurface" Grid.Row="1" VerticalAlignment="Center" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0.75" CornerRadius="20">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid x:Name="InspectorHeaderHost" Height="54" ClipToBounds="True">
                        <ContentControl x:Name="InspectorHeaderContent" Margin="20,0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"/>
                        <Grid x:Name="InspectorHeaderTransitionLayer" Margin="20,0" IsHitTestVisible="False"/>
                        <Border Height="0.75" VerticalAlignment="Bottom" Background="{DynamicResource LineBrush}"/>
                    </Grid>
                    <Border x:Name="InspectorNavigationHost" Grid.Row="1" Visibility="Collapsed" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,0.75">
                        <ContentControl x:Name="InspectorNavigation" Margin="20,8" HorizontalContentAlignment="Stretch"/>
                    </Border>
                    <Grid Grid.Row="2" ClipToBounds="True" Margin="20,0,20,16">
                        <ScrollViewer x:Name="InspectorScroll" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="Inspector"/>
                        </ScrollViewer>
                        <Grid x:Name="InspectorTransitionLayer" IsHitTestVisible="False" ClipToBounds="True"/>
                    </Grid>
                </Grid>
                </Border>
            </Grid>
        </Grid>
        <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="Transparent" Cursor="SizeNS" DragCompleted="TimelineSplitter_DragCompleted" ToolTip="{local:Localize '拖动调整时间线高度'}" AutomationProperties.Name="{local:Localize '时间线高度'}">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="{TemplateBinding Background}">
                        <Border Width="40" Height="2" CornerRadius="1" Background="{DynamicResource LineBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>
        <Border x:Name="TimelineSurface" Grid.Row="3" Margin="10,0,10,10" CornerRadius="20" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0.75">
            <Grid Margin="0,4,0,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid x:Name="TimelineToolbar" Margin="12,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button ToolTip="{local:Localize '分割（S）'}" AutomationProperties.Name="{local:Localize '分割'}" Style="{StaticResource IconButton}" Click="Split_Click"><local:Icon Kind="Scissors"/></Button>
                        <Button ToolTip="{local:Localize '删除（Delete）'}" AutomationProperties.Name="{local:Localize '删除'}" Style="{StaticResource IconButton}" Click="Delete_Click"><local:Icon Kind="Trash"/></Button>
                        <Button x:Name="RestoreButton" ToolTip="{local:Localize '还原剪掉的素材'}" AutomationProperties.Name="{local:Localize '还原'}" Style="{StaticResource IconButton}" Click="Restore_Click"><local:Icon Kind="Undo"/></Button>
                        <Border Background="{DynamicResource SegmentWellBrush}" CornerRadius="10" Padding="3" Margin="8,0,0,0" VerticalAlignment="Center">
                            <Grid x:Name="TimelineViewChoices">
                                <Button x:Name="VideoViewButton" Content="{local:Localize '视频'}" Style="{StaticResource TimelineChip}" Click="TimelineView_Click" Tag="video"/>
                                <Button x:Name="WaveformViewButton" Content="{local:Localize '波形'}" Style="{StaticResource TimelineChip}" Click="TimelineView_Click" Tag="waveform"/>
                            </Grid>
                        </Border>
                        <CheckBox x:Name="MarkersToggle" Content="{local:Localize '标记'}" Style="{StaticResource ToolbarToggle}" IsChecked="True" VerticalAlignment="Center" Margin="8,0" Click="MarkersToggle_Click"/>
                        <Button Style="{StaticResource IconButton}" ToolTip="{local:Localize '更多编辑操作'}" Click="EditMenu_Click">
                            <local:Icon Kind="Menu"/>
                            <Button.ContextMenu><ContextMenu>
                                <MenuItem Header="{local:Localize '添加标记（M）'}" Click="Marker_Click"/>
                                <MenuItem Header="{local:Localize '复制效果（Ctrl+C）'}" Click="CopyEffect_Click"/>
                                <MenuItem Header="{local:Localize '粘贴效果（Ctrl+V）'}" Click="PasteEffect_Click"/>
                                <MenuItem Header="{local:Localize '只粘属性（Ctrl+Shift+V）'}" Click="PasteAttributes_Click"/>
                            </ContextMenu></Button.ContextMenu>
                        </Button>
                        <ComboBox x:Name="SpeedBox" Visibility="Collapsed" SelectionChanged="Speed_Changed"/>
                    </StackPanel>
                    <Canvas Grid.Column="1" Width="138" Height="40" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Canvas.Top="3">
                        <Button ToolTip="{local:Localize '回到开头'}" AutomationProperties.Name="{local:Localize '回到开头'}" Style="{StaticResource PlaybackButton}" Click="SkipStart_Click"><local:Icon Kind="SkipStart" Width="20" Height="20"/></Button>
                        <Button x:Name="PlayButton" ToolTip="{local:Localize '播放（Space）'}" AutomationProperties.Name="{local:Localize '播放'}" Style="{StaticResource PlaybackButton}" Click="Play_Click"><local:Icon x:Name="PlayIcon" Kind="Play" Width="20" Height="20"/></Button>
                        <Button ToolTip="{local:Localize '跳到结尾'}" AutomationProperties.Name="{local:Localize '跳到结尾'}" Style="{StaticResource PlaybackButton}" Click="SkipEnd_Click"><local:Icon Kind="SkipEnd" Width="20" Height="20"/></Button>
                      </StackPanel>
                        <TextBlock x:Name="TimeLabel" VerticalAlignment="Center" Canvas.Left="148" Canvas.Top="14" Width="146" TextTrimming="CharacterEllipsis" FontSize="11" FontFamily="{DynamicResource FontMedium}" FontWeight="Medium"/>
                    </Canvas>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <CheckBox x:Name="SnapToggle" Content="{local:Localize '吸附'}" Style="{StaticResource ToolbarToggle}" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0" Checked="SnapToggle_Changed" Unchecked="SnapToggle_Changed" ToolTip="{local:Localize '拖动时按刻度与片段边缘吸附'}"/>
                        <ComboBox x:Name="PreviewQualityBox" Visibility="Collapsed" Width="106" VerticalAlignment="Center" Margin="0,0,8,0" SelectionChanged="PreviewQuality_Changed" ToolTip="{local:Localize '预览画质'}">
                            <ComboBoxItem Content="{local:Localize '流畅预览'}" Tag="low"/><ComboBoxItem Content="{local:Localize '完整分辨率'}" Tag="full"/>
                        </ComboBox>
                        <Button Content="{local:Localize '预览'}" Style="{StaticResource QuietButton}" Padding="6,4" FontSize="11" VerticalAlignment="Center" Click="PreviewMenu_Click" Margin="0,0,8,0"/>
                        <TextBlock Text="−" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Slider x:Name="TimelineZoom" Width="70" Minimum="1" Maximum="6" Value="1" ValueChanged="TimelineZoom_Changed"/>
                        <TextBlock Text="＋" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        <Button x:Name="TrackMenuButton" Content="{local:Localize '轨道'}" Visibility="Collapsed" Margin="8,0,0,0" VerticalAlignment="Center" Click="TrackMenu_Click">
                            <Button.ContextMenu><ContextMenu x:Name="TrackMenu" Opened="TrackMenu_Opened">
                                <MenuItem x:Name="TrackZoomItem" Header="{local:Localize '缩放'}" IsCheckable="True" Click="TrackItem_Click"/>
                                <MenuItem x:Name="TrackScreenMotionItem" Header="{local:Localize '屏幕运动'}" IsCheckable="True" Click="TrackItem_Click"/>
                                <MenuItem x:Name="TrackCameraMotionItem" Header="{local:Localize '摄像头运动'}" IsCheckable="True" Click="TrackItem_Click"/>
                                <Separator/><MenuItem x:Name="TrackOverlayItem" Header="{local:Localize '叠加（贴图/柔化）'}" IsCheckable="True" Click="TrackItem_Click"/>
                            </ContextMenu></Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><local:TimelineControl x:Name="Timeline" Grid.Row="1"/></ScrollViewer>
            </Grid>
        </Border>
        <Border x:Name="ModalShade" Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="98" Background="#55000000" Visibility="Collapsed"/>
        <Grid x:Name="TourOverlay" Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="99" Visibility="Collapsed" Background="#66000000" KeyboardNavigation.TabNavigation="Cycle">
            <Border x:Name="TourCard" Width="380" Padding="24" CornerRadius="14" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="TourTitle" FontFamily="{DynamicResource FontSemi}" FontWeight="SemiBold" FontSize="20" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TourBody" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource InkSecondaryBrush}"/>
                    <TextBlock x:Name="TourStep" Margin="0,14,0,0" Foreground="{DynamicResource InkSecondaryBrush}"/>
                    <DockPanel Margin="0,12,0,0">
                        <Button Content="{local:Localize '跳过'}" DockPanel.Dock="Left" Style="{StaticResource QuietButton}" Click="TourSkip_Click"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="TourPrev" Content="{local:Localize '上一步'}" Style="{StaticResource QuietButton}" Margin="0,0,8,0" Click="TourPrev_Click"/>
                            <Button x:Name="TourNext" Content="{local:Localize '下一步'}" Style="{StaticResource PrimaryButton}" Click="TourNext_Click"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
