<Window x:Class="DogSC.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DogSC"
        Title="{local:Localize '导出作品'}" Width="842" Height="635" MinHeight="520" WindowStartupLocation="CenterOwner"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        FontFamily="{DynamicResource FontRegular}">
    <Border CornerRadius="24" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0.75">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="90"/><RowDefinition Height="*"/><RowDefinition Height="84"/></Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,0.75" Padding="28,20" MouseLeftButtonDown="Header_Down">
            <DockPanel>
                <Button DockPanel.Dock="Right" Width="30" Height="30" Padding="8" VerticalAlignment="Center" Style="{StaticResource DismissButton}" Click="Cancel_Click" ToolTip="{local:Localize '关闭导出窗口'}"><local:Icon Kind="Close" Width="13" Height="13"/></Button>
                <local:Icon DockPanel.Dock="Left" Kind="Share" Width="19" Height="19" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{local:Localize '导出作品'}" FontFamily="{DynamicResource FontMedium}" FontWeight="Medium" FontSize="18"/>
                    <TextBlock x:Name="ProjectName" FontSize="12" Margin="0,5,0,0" Foreground="{DynamicResource InkSecondaryBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" ClipToBounds="True">
        <Grid x:Name="ExportSettings" Margin="28,26,28,28">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.06*"/><ColumnDefinition Width="0.75"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ScrollViewer x:Name="ExportOptionsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,28,0">
            <StackPanel>
                <TextBlock Text="{local:Localize '文件名'}" FontSize="12" Foreground="{DynamicResource InkSecondaryBrush}"/>
                <Border Height="44" CornerRadius="12" Background="{DynamicResource SegmentSelectedBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="0.75" Padding="12,0" Margin="0,9,0,9" MouseLeftButtonDown="FileNameRow_Down" ToolTip="{local:Localize '更改文件名'}">
                    <DockPanel>
                        <local:Icon x:Name="FileNamePencil" DockPanel.Dock="Right" Kind="Pencil" Width="11" Height="11" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource InkSecondaryBrush}"/>
                        <Border DockPanel.Dock="Right" CornerRadius="12" Padding="8,4" Background="{DynamicResource HoverBrush}" VerticalAlignment="Center"><TextBlock x:Name="ExtensionLabel" Text=".mp4" FontSize="12" Foreground="{DynamicResource InkSecondaryBrush}"/></Border>
                        <Grid Margin="0,0,8,0">
                            <TextBlock x:Name="FileNameDisplay" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBox x:Name="FileName" Visibility="Collapsed" BorderThickness="0" Background="Transparent" FontSize="13" Padding="0" VerticalContentAlignment="Center" KeyDown="FileName_KeyDown" LostKeyboardFocus="FileName_LostFocus"/>
                        </Grid>
                    </DockPanel>
                </Border>
                <Button x:Name="FolderButton" Style="{StaticResource QuietButton}" Height="32" FontSize="11" Padding="12,0" HorizontalContentAlignment="Stretch" Click="Folder_Click">
                    <DockPanel>
                        <local:Icon Kind="ChevronRight" Width="9" Height="9" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                        <local:Icon Kind="Folder" Width="12" Height="12" DockPanel.Dock="Left" Margin="0,0,7,0"/>
                        <TextBlock x:Name="FolderPath" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </DockPanel>
                </Button>
                <TextBlock Text="{local:Localize '导出内容'}" Margin="0,24,0,10" FontSize="13"/>
                <UniformGrid x:Name="OutputChoicesRow" Rows="1">
                    <Button x:Name="VideoChoice" Content="{local:Localize '视频'}" Style="{StaticResource SegmentButton}" MinHeight="38" Margin="0,0,5,0" Click="Video_Click"/>
                    <Button x:Name="AudioChoice" Content="{local:Localize '仅音频'}" Style="{StaticResource SegmentButton}" MinHeight="38" Margin="5,0,0,0" Click="Audio_Click"/>
                </UniformGrid>
                <StackPanel x:Name="VideoSettings">
                    <TextBlock Text="{local:Localize '分辨率'}" Margin="0,24,0,10" FontSize="13"/>
                    <UniformGrid x:Name="ResolutionRow" Rows="1"/>
                    <TextBlock Text="{local:Localize '帧率'}" Margin="0,24,0,10" FontSize="13"/>
                    <UniformGrid x:Name="FrameRateChoicesRow" Rows="1">
                        <Button x:Name="Fps30" Content="30 FPS" Style="{StaticResource SegmentButton}" MinHeight="38" Margin="0,0,5,0" Click="Fps_Click" Tag="30"/>
                        <Button x:Name="Fps60" Content="60 FPS" Style="{StaticResource SegmentButton}" MinHeight="38" Margin="5,0,0,0" Click="Fps_Click" Tag="60"/>
                    </UniformGrid>
                </StackPanel>
                <TextBlock x:Name="AudioDescription" Visibility="Collapsed" Text="{local:Localize '导出剪辑后的系统声音与麦克风混音。'}" FontSize="12" Margin="0,24,0,0" Foreground="{DynamicResource InkSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            </ScrollViewer>
            <Border Grid.Column="1" Background="{DynamicResource LineBrush}"/>
            <StackPanel Grid.Column="2" Margin="28,0,0,0">
                <TextBlock x:Name="PreviewHeading" Text="{local:Localize '当前画面'}" FontSize="12" Foreground="{DynamicResource InkSecondaryBrush}"/>
                <Border x:Name="VideoPreview" Height="194" CornerRadius="16" ClipToBounds="True" Background="{DynamicResource SegmentWellBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0.75" Margin="0,16,0,16">
                    <Image x:Name="PreviewImage" Stretch="Uniform"/>
                </Border>
                <Border x:Name="AudioPreview" Visibility="Collapsed" Height="194" CornerRadius="16" Background="{DynamicResource SegmentWellBrush}" Margin="0,16,0,16">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <local:Icon Kind="Waveform" Width="38" Height="38" HorizontalAlignment="Center" Foreground="{DynamicResource InkSecondaryBrush}"/>
                        <TextBlock Text="M4A" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,0" Foreground="{DynamicResource InkSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                <DockPanel Height="28"><TextBlock x:Name="FormatValue" DockPanel.Dock="Right" FontSize="12" VerticalAlignment="Center"/><TextBlock Text="{local:Localize '格式'}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource InkSecondaryBrush}"/></DockPanel>
                <StackPanel x:Name="VideoMetadata">
                    <DockPanel Height="28"><TextBlock x:Name="ResolutionValue" DockPanel.Dock="Right" FontSize="12" VerticalAlignment="Center"/><TextBlock Text="{local:Localize '分辨率'}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource InkSecondaryBrush}"/></DockPanel>
                    <DockPanel Height="28"><TextBlock x:Name="FpsValue" DockPanel.Dock="Right" FontSize="12" VerticalAlignment="Center"/><TextBlock Text="{local:Localize '帧率'}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource InkSecondaryBrush}"/></DockPanel>
                </StackPanel>
                <DockPanel Height="28"><TextBlock x:Name="DurationValue" DockPanel.Dock="Right" FontSize="12" VerticalAlignment="Center"/><TextBlock Text="{local:Localize '时长'}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource InkSecondaryBrush}"/></DockPanel>
                <TextBlock x:Name="Summary" Visibility="Collapsed"/>
                <ProgressBar x:Name="Bar" Visibility="Collapsed" Height="6" Margin="0,20,0,6" Minimum="0" Maximum="1"/>
                <TextBlock x:Name="Status" Visibility="Collapsed" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource InkSecondaryBrush}"/>
            </StackPanel>
        </Grid>
        <Grid x:Name="ExportTransitionLayer" IsHitTestVisible="False" ClipToBounds="True" Margin="28,26,28,28"/>
        </Grid>
        <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0.75,0,0" Padding="28,20">
            <DockPanel>
                <Button x:Name="ExportButton" DockPanel.Dock="Right" Content="{local:Localize '导出视频'}" Style="{StaticResource PrimaryButton}" Click="Export_Click" Padding="20,10"/>
                <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="{local:Localize '取消'}" Style="{StaticResource QuietButton}" Click="Cancel_Click" Margin="0,0,12,0"/>
                <Button x:Name="LogButton" DockPanel.Dock="Right" Visibility="Collapsed" Content="{local:Localize '查看日志'}" Style="{StaticResource QuietButton}" Click="Log_Click" Margin="0,0,12,0"/>
                <TextBlock x:Name="Estimate" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource InkSecondaryBrush}"/>
            </DockPanel>
        </Border>
    </Grid>
    </Border>
</Window>
