<Window x:Class="DogSC.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DogSC"
        Title="导出作品" Width="842" Height="635" MinHeight="520" WindowStartupLocation="CenterOwner"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        FontFamily="{DynamicResource FontRegular}">
    <Border CornerRadius="24" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0.75">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="90"/><RowDefinition Height="*"/><RowDefinition Height="84"/></Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,0.75" Padding="28,20" MouseLeftButtonDown="Header_Down">
            <DockPanel>
                <Button DockPanel.Dock="Right" Width="32" Height="32" Padding="8" VerticalAlignment="Center" Style="{StaticResource QuietButton}" Click="Cancel_Click" ToolTip="关闭导出窗口"><local:Icon Kind="Close" Width="16" Height="16"/></Button>
                <local:Icon DockPanel.Dock="Left" Kind="Share" Width="24" Height="24" Margin="0,0,14,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="导出项目" FontFamily="{DynamicResource FontSemi}" FontSize="20"/>
                    <TextBlock x:Name="ProjectName" FontSize="12" Margin="0,5,0,0" Foreground="{DynamicResource InkSecondaryBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" ClipToBounds="True">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="ExportSettings" Margin="28,26,28,28">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.06*"/><ColumnDefinition Width="0.75"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,28,0">
                <TextBlock Text="文件名" FontSize="12" Foreground="{DynamicResource InkSecondaryBrush}"/>
                <Border CornerRadius="12" Background="{DynamicResource SegmentSelectedBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0.75" Padding="12,7" Margin="0,10,0,8">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" CornerRadius="12" Padding="8,4" Background="{DynamicResource ValueWellBrush}"><TextBlock x:Name="ExtensionLabel" Text=".mp4" FontSize="12" Foreground="{DynamicResource InkSecondaryBrush}"/></Border>
                        <TextBox x:Name="FileName" BorderThickness="0" Background="Transparent" FontSize="13" Padding="0" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                    </DockPanel>
                </Border>
                <Button x:Name="FolderButton" Style="{StaticResource QuietButton}" FontSize="12" Padding="12,8" HorizontalContentAlignment="Stretch" Click="Folder_Click">
                    <DockPanel>
                        <local:Icon Kind="ChevronRight" Width="12" Height="12" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                        <local:Icon Kind="Folder" Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"/>
                        <TextBlock x:Name="FolderPath" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </DockPanel>
                </Button>
                <TextBlock Text="导出内容" Margin="0,24,0,10" FontSize="13"/>
                <UniformGrid x:Name="OutputChoicesRow" Rows="1">
                    <Button x:Name="VideoChoice" Content="视频" Style="{StaticResource SegmentButton}" MinHeight="38" Margin="0,0,5,0" Click="Video_Click"/>
                    <Button x:Name="AudioChoice" Content="仅音频" Style="{StaticResource SegmentButton}" MinHeight="38" Margin="5,0,0,0" Click="Audio_Click"/>
                </UniformGrid>
                <StackPanel x:Name="VideoSettings">
                    <TextBlock Text="分辨率" Margin="0,24,0,10" FontSize="13"/>
                    <UniformGrid x:Name="ResolutionRow" Rows="1"/>
                    <TextBlock Text="帧率" Margin="0,24,0,10" FontSize="13"/>
                    <UniformGrid x:Name="FrameRateChoicesRow" Rows="1">
                        <Button x:Name="Fps30" Content="30 FPS" Style="{StaticResource SegmentButton}" MinHeight="38" Margin="0,0,5,0" Click="Fps_Click" Tag="30"/>
                        <Button x:Name="Fps60" Content="60 FPS" Style="{StaticResource SegmentButton}" MinHeight="38" Margin="5,0,0,0" Click="Fps_Click" Tag="60"/>
                    </UniformGrid>
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource LineBrush}"/>
            <StackPanel Grid.Column="2" Margin="28,0,0,0">
                <TextBlock Text="当前画面" FontSize="12" Foreground="{DynamicResource InkSecondaryBrush}"/>
                <Border x:Name="VideoPreview" Height="194" CornerRadius="16" ClipToBounds="True" Background="{DynamicResource SegmentWellBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0.75" Margin="0,16,0,20">
                    <Image x:Name="PreviewImage" Stretch="Uniform"/>
                </Border>
                <Border x:Name="AudioPreview" Visibility="Collapsed" Height="194" CornerRadius="16" Background="{DynamicResource SegmentWellBrush}" Margin="0,16,0,20">
                    <local:Icon Kind="Speaker" Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource InkSecondaryBrush}"/>
                </Border>
                <DockPanel Margin="0,0,0,12"><TextBlock x:Name="FormatValue" DockPanel.Dock="Right" FontSize="12"/><TextBlock Text="格式" FontSize="12" Foreground="{DynamicResource InkSecondaryBrush}"/></DockPanel>
                <StackPanel x:Name="VideoMetadata">
                    <DockPanel Margin="0,0,0,12"><TextBlock x:Name="ResolutionValue" DockPanel.Dock="Right" FontSize="12"/><TextBlock Text="分辨率" FontSize="12" Foreground="{DynamicResource InkSecondaryBrush}"/></DockPanel>
                    <DockPanel Margin="0,0,0,12"><TextBlock x:Name="FpsValue" DockPanel.Dock="Right" FontSize="12"/><TextBlock Text="帧率" FontSize="12" Foreground="{DynamicResource InkSecondaryBrush}"/></DockPanel>
                </StackPanel>
                <DockPanel><TextBlock x:Name="DurationValue" DockPanel.Dock="Right" FontSize="12"/><TextBlock Text="时长" FontSize="12" Foreground="{DynamicResource InkSecondaryBrush}"/></DockPanel>
                <TextBlock x:Name="Summary" Visibility="Collapsed"/>
                <ProgressBar x:Name="Bar" Visibility="Collapsed" Height="6" Margin="0,20,0,6" Minimum="0" Maximum="1"/>
                <TextBlock x:Name="Status" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource InkSecondaryBrush}"/>
            </StackPanel>
        </Grid>
        </ScrollViewer>
        <Grid x:Name="ExportTransitionLayer" IsHitTestVisible="False" ClipToBounds="True" Margin="28,26,28,28"/>
        </Grid>
        <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0.75,0,0" Padding="28,20">
            <DockPanel>
                <Button x:Name="ExportButton" DockPanel.Dock="Right" Content="导出视频" Style="{StaticResource PrimaryButton}" Click="Export_Click" Padding="20,10"/>
                <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="取消" Style="{StaticResource QuietButton}" Click="Cancel_Click" Margin="0,0,12,0"/>
                <TextBlock x:Name="Estimate" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource InkSecondaryBrush}"/>
            </DockPanel>
        </Border>
    </Grid>
    </Border>
</Window>
