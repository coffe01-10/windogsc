<Window x:Class="DogSC.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="520" Height="540" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}" ResizeMode="NoResize"
        FontFamily="{DynamicResource FontRegular}">
    <StackPanel Margin="24">
        <TextBlock Text="设置" FontFamily="{DynamicResource FontSemi}" FontSize="22"/>
        <TextBlock Text="录制帧率" Margin="0,18,0,6" Foreground="{DynamicResource InkSecondaryBrush}"/>
        <StackPanel Orientation="Horizontal">
            <Button x:Name="Fps30" Content="30 FPS" Style="{StaticResource ChipButton}" Click="Fps30_Click"/>
            <Button x:Name="Fps60" Content="60 FPS" Style="{StaticResource ChipButton}" Click="Fps60_Click"/>
        </StackPanel>
        <TextBlock Text="预览画质" Margin="0,18,0,6" Foreground="{DynamicResource InkSecondaryBrush}"/>
        <StackPanel Orientation="Horizontal">
            <Button x:Name="QualityLow" Content="清晰预览（流畅）" Style="{StaticResource ChipButton}" Click="QualityLow_Click"/>
            <Button x:Name="QualityFull" Content="完整分辨率" Style="{StaticResource ChipButton}" Click="QualityFull_Click"/>
        </StackPanel>
        <TextBlock Text="ffmpeg" Margin="0,18,0,6" Foreground="{DynamicResource InkSecondaryBrush}"/>
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="浏览" Style="{StaticResource QuietButton}" Click="BrowseFfmpeg_Click"/>
            <TextBlock x:Name="FfmpegLabel" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <TextBlock x:Name="UpdateLabel" Margin="0,18,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource InkSecondaryBrush}"/>
        <TextBlock Margin="0,18,0,0" TextWrapping="Wrap" Foreground="{DynamicResource InkSecondaryBrush}"
                   Text="DogSC Windows。支持屏幕录制、剪辑、效果复制及导出，也可导入 macOS 项目；部分 macOS 画面效果暂未支持。"/>
        <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource InkSecondaryBrush}">
            <Hyperlink NavigateUri="https://github.com/laogou717/dogsc" RequestNavigate="Link_Click">github.com/laogou717/dogsc</Hyperlink>
        </TextBlock>
        <Button Content="关闭" HorizontalAlignment="Right" Margin="0,24,0,0" Style="{StaticResource PrimaryButton}" IsCancel="True" Click="Close_Click"/>
    </StackPanel>
</Window>
