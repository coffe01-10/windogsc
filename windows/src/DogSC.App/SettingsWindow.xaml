<Window x:Class="DogSC.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DogSC"
        Title="DogSC 设置" Width="796" Height="679" MinHeight="520" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CardBrush}" ResizeMode="NoResize" UseLayoutRounding="True"
        FontFamily="{DynamicResource FontRegular}" PreviewKeyDown="Settings_KeyDown">
    <Grid x:Name="SettingsRoot">
        <Grid.ColumnDefinitions><ColumnDefinition Width="156"/><ColumnDefinition Width="0.75"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource SettingsSidebarBrush}">
            <Grid Margin="12,24,12,8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="设置" FontFamily="{DynamicResource FontSemi}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource InkSecondaryBrush}" Margin="12,0,12,14"/>
                    <Grid x:Name="NavigationGrid">
                        <Border x:Name="NavigationSelection" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource SelectionBrush}" IsHitTestVisible="False">
                            <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                        </Border>
                        <StackPanel x:Name="NavigationButtons"/>
                    </Grid>
                </StackPanel>
                <Button Grid.Row="2" Style="{StaticResource QuietButton}" Padding="10,8" HorizontalContentAlignment="Left" Click="ReplayTour_Click" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal"><local:Icon Kind="Sparkles" Width="18" Height="18" Margin="0,0,8,0"/><TextBlock Text="首次使用引导" FontSize="12" VerticalAlignment="Center"/></StackPanel>
                </Button>
                <TextBlock Grid.Row="3" Text="DogSC" Margin="12,8,0,8" FontSize="11" Foreground="{DynamicResource InkSecondaryBrush}" Opacity="0.6"/>
            </Grid>
        </Border>
        <Border Grid.Column="1" Background="{DynamicResource LineBrush}"/>
        <Grid Grid.Column="2" ClipToBounds="True">
            <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ContentControl x:Name="SettingsPage" Margin="24" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"/>
            </ScrollViewer>
            <Grid x:Name="SettingsTransitionLayer" IsHitTestVisible="False" ClipToBounds="True"/>
        </Grid>
    </Grid>
</Window>
