<Window x:Class="DogSC.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="560" Height="560" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}" ResizeMode="NoResize"
        FontFamily="{DynamicResource FontRegular}">
    <DockPanel Margin="20">
        <DockPanel DockPanel.Dock="Bottom">
            <Button Content="关闭" HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" IsCancel="True" Click="Close_Click"/>
        </DockPanel>
        <TabControl x:Name="Tabs" Margin="0,0,0,12" BorderThickness="0" Background="Transparent">
            <TabItem Header="通用">
                <StackPanel Margin="4,16,4,0">
                    <TextBlock Text="录制帧率" Margin="0,0,0,6" Foreground="{DynamicResource InkSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="Fps30" Content="30 FPS" Style="{StaticResource ChipButton}" Click="Fps30_Click"/>
                        <Button x:Name="Fps60" Content="60 FPS" Style="{StaticResource ChipButton}" Click="Fps60_Click"/>
                    </StackPanel>
                    <TextBlock Text="预览画质" Margin="0,18,0,6" Foreground="{DynamicResource InkSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="QualityLow" Content="清晰预览（流畅）" Style="{StaticResource ChipButton}" Click="QualityLow_Click"/>
                        <Button x:Name="QualityFull" Content="完整分辨率" Style="{StaticResource ChipButton}" Click="QualityFull_Click"/>
                    </StackPanel>
                    <TextBlock Text="ffmpeg" Margin="0,18,0,6" Foreground="{DynamicResource InkSecondaryBrush}"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="浏览" Style="{StaticResource QuietButton}" Click="BrowseFfmpeg_Click"/>
                        <TextBlock x:Name="FfmpegLabel" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <CheckBox x:Name="CheckUpdatesBox" Content="启动时检查新版本（只提示，不自动更新）" Margin="0,18,0,0" Click="CheckUpdates_Changed"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="录制">
                <StackPanel Margin="4,16,4,0">
                    <TextBlock Text="摄像头默认形状" Margin="0,0,0,6" Foreground="{DynamicResource InkSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="CamCircle" Content="圆形" Style="{StaticResource ChipButton}" Click="CamCircle_Click"/>
                        <Button x:Name="CamSquare" Content="方形" Style="{StaticResource ChipButton}" Click="CamSquare_Click"/>
                        <Button x:Name="CamRounded" Content="圆角" Style="{StaticResource ChipButton}" Click="CamRounded_Click"/>
                    </StackPanel>
                    <TextBlock Text="录制倒计时" Margin="0,18,0,6" Foreground="{DynamicResource InkSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="Cd0" Content="关" Style="{StaticResource ChipButton}" Click="Cd0_Click"/>
                        <Button x:Name="Cd3" Content="3 秒" Style="{StaticResource ChipButton}" Click="Cd3_Click"/>
                        <Button x:Name="Cd5" Content="5 秒" Style="{StaticResource ChipButton}" Click="Cd5_Click"/>
                    </StackPanel>
                    <TextBlock Text="麦克风与系统声音可在录制条上单独开关；此处是新项目的默认值。" TextWrapping="Wrap" Margin="0,18,0,0" Foreground="{DynamicResource InkSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <CheckBox x:Name="MicDefaultBox" Content="默认开麦克风" Margin="0,0,16,0" Click="MicDefault_Changed"/>
                        <CheckBox x:Name="SysAudioDefaultBox" Content="默认录系统声音" Click="SysAudioDefault_Changed"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>
            <TabItem Header="编辑器">
                <StackPanel Margin="4,16,4,0">
                    <TextBlock Text="布局" Margin="0,0,0,6" Foreground="{DynamicResource InkSecondaryBrush}"/>
                    <Button Content="重置编辑器布局（恢复默认轨道显示与时间线缩放）" Style="{StaticResource QuietButton}" Click="ResetLayout_Click" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="ResetDone" Margin="0,8,0,0" Foreground="{DynamicResource InkSecondaryBrush}"/>
                    <TextBlock Text="首次使用引导" Margin="0,18,0,6" Foreground="{DynamicResource InkSecondaryBrush}"/>
                    <Button Content="重新播放引导" Style="{StaticResource QuietButton}" Click="ReplayTour_Click" HorizontalAlignment="Left"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="权限">
                <StackPanel Margin="4,16,4,0">
                    <TextBlock Text="屏幕录制" FontFamily="{DynamicResource FontSemi}"/>
                    <TextBlock TextWrapping="Wrap" Text="Windows 使用图形捕获 API 录制屏幕与应用窗口；首次录制时系统可能提示授权。" Margin="0,4,0,0" Foreground="{DynamicResource InkSecondaryBrush}"/>
                    <TextBlock Text="摄像头" Margin="0,14,0,0" FontFamily="{DynamicResource FontSemi}"/>
                    <TextBlock TextWrapping="Wrap" Text="画中画录制需要摄像头设备访问权限。" Margin="0,4,0,0" Foreground="{DynamicResource InkSecondaryBrush}"/>
                    <TextBlock Text="麦克风" Margin="0,14,0,0" FontFamily="{DynamicResource FontSemi}"/>
                    <TextBlock TextWrapping="Wrap" Text="解说录制需要麦克风访问权限；未授权时录制会跳过麦克风轨。" Margin="0,4,0,0" Foreground="{DynamicResource InkSecondaryBrush}"/>
                    <Button Content="打开系统隐私设置" Margin="0,16,0,0" Style="{StaticResource QuietButton}" Click="OpenPrivacy_Click" HorizontalAlignment="Left"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="关于">
                <StackPanel Margin="4,16,4,0">
                    <TextBlock x:Name="UpdateLabel" Foreground="{DynamicResource InkSecondaryBrush}"/>
                    <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Text="DogSC Windows。支持屏幕录制、剪辑、效果复制及导出，也可导入 macOS 项目；部分 macOS 画面效果暂未支持。" Foreground="{DynamicResource InkSecondaryBrush}"/>
                    <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource InkSecondaryBrush}">
                        <Hyperlink NavigateUri="https://github.com/coffe01-10/windogsc" RequestNavigate="Link_Click">源代码 github.com/coffe01-10/windogsc</Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource InkSecondaryBrush}">
                        <Hyperlink NavigateUri="https://github.com/coffe01-10/windogsc/issues" RequestNavigate="Link_Click">反馈与建议</Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource InkSecondaryBrush}">
                        <Hyperlink NavigateUri="https://github.com/laogou717/dogsc" RequestNavigate="Link_Click">macOS 原版 laogou717/dogsc</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
