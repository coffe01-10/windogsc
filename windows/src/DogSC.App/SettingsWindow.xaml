<Window x:Class="DogSC.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DogSC"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{local:Localize 'DogSC 设置'}" Width="780" Height="674" MinHeight="434" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CardBrush}" ResizeMode="CanMinimize" UseLayoutRounding="True"
        FontFamily="{DynamicResource FontRegular}" PreviewKeyDown="Settings_KeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="14" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="SettingsCaptionButton" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocus}"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border Width="12" Height="12" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="#22000000" BorderThickness="0.5"/>
                            <ContentPresenter x:Name="CaptionGlyph" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CaptionGlyph" Property="Opacity" Value="1"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CaptionGlyph" Property="Opacity" Value="1"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.7"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border CornerRadius="14" BorderThickness="0.75" BorderBrush="{DynamicResource LineBrush}">
    <Grid x:Name="SettingsShell">
        <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid x:Name="SettingsTitleBar" Background="{DynamicResource CardBrush}">
            <StackPanel Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
                <Button Style="{StaticResource SettingsCaptionButton}" Background="#FF6058" Click="Close_Click" ToolTip="{local:Localize '关闭'}" AutomationProperties.Name="{local:Localize '关闭'}">
                    <local:Icon Kind="Close" Width="12" Height="12" Foreground="#790600"/>
                </Button>
                <Button Style="{StaticResource SettingsCaptionButton}" Background="#FEBC2E" Click="Minimize_Click" ToolTip="{local:Localize '最小化'}" AutomationProperties.Name="{local:Localize '最小化'}">
                    <Path Data="M 2,6 L 10,6" Stroke="#855900" StrokeThickness="1" Width="12" Height="12"/>
                </Button>
                <Border Width="22" Height="24"><Border Width="12" Height="12" CornerRadius="6" Background="{DynamicResource LineBrush}"/></Border>
                <TextBlock Text="{local:Localize 'DogSC 设置'}" FontSize="13" FontFamily="{DynamicResource FontSemi}" FontWeight="SemiBold" Foreground="{DynamicResource InkSecondaryBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    <Grid x:Name="SettingsRoot" Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="156"/><ColumnDefinition Width="0.75"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource SettingsSidebarBrush}">
            <Grid Margin="12,24,12,8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="{local:Localize '设置'}" FontFamily="{DynamicResource FontSemi}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource InkSecondaryBrush}" Margin="12,0,12,14"/>
                    <Grid x:Name="NavigationGrid">
                        <Border x:Name="NavigationSelection" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource SelectionBrush}" IsHitTestVisible="False">
                            <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                        </Border>
                        <StackPanel x:Name="NavigationButtons"/>
                    </Grid>
                </StackPanel>
                <Button Grid.Row="2" Style="{StaticResource QuietButton}" Height="36" Padding="10,0" HorizontalContentAlignment="Left" Click="ReplayTour_Click">
                    <StackPanel Orientation="Horizontal"><Border Width="18" Margin="0,0,8,0"><local:Icon Kind="Sparkles" Width="14" Height="14"/></Border><TextBlock Text="{local:Localize '首次使用引导'}" FontSize="12" VerticalAlignment="Center"/></StackPanel>
                </Button>
                <TextBlock Grid.Row="3" Text="DogSC" Margin="12" FontSize="11" Foreground="{DynamicResource InkSecondaryBrush}" Opacity="0.6"/>
            </Grid>
        </Border>
        <Border Grid.Column="1" Background="{DynamicResource LineBrush}"/>
        <Grid Grid.Column="2" ClipToBounds="True">
            <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ContentControl x:Name="SettingsPage" Margin="24" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"/>
            </ScrollViewer>
            <Grid x:Name="SettingsTransitionLayer" IsHitTestVisible="False" ClipToBounds="True"/>
        </Grid>
    </Grid>
    </Grid>
    </Border>
</Window>
